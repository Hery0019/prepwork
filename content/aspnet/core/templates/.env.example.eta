<%
const db = it.stack.database;
const dbName = it.project.dbName;
const defaultConnection = db === 'postgresql'
  ? `Host=localhost;Port=5432;Database=${dbName};Username=${dbName};Password=${dbName}`
  : db === 'sqlserver'
    ? `Server=localhost,1433;Database=${dbName};User Id=sa;Password=Local_dev_1;TrustServerCertificate=True`
    : '';
const override = (name, fallback) => (it.extras.envOverrides && it.extras.envOverrides[name]) || fallback;
-%>
# <%= it.d("Variables d'environnement attendues par l'application (CORE-030). Copier en `.env`, jamais commiter `.env`.", 'Environment variables expected by the application (CORE-030). Copy to `.env`, never commit `.env`.') %>
<% if (db !== 'none') { -%>

# <%= it.d('Chaîne de connexion à la base', 'Database connection string') %>
DB_CONNECTION_STRING=<%= override('DB_CONNECTION_STRING', defaultConnection) %>
<% } -%>

# <%= it.d('Origines CORS autorisées, séparées par des virgules (jamais `*` en production, CORE-033)', 'Allowed CORS origins, comma-separated (never `*` in production, CORE-033)') %>
CORS_ORIGINS=<%= override('CORS_ORIGINS', 'http://localhost:3000') %>
<% for (const variable of it.env) { -%>

# <%= it.text(variable.comment) %>
<%= variable.name %>=<%= override(variable.name, variable.example) %>
<% } -%>
