<!-- <%= it.d("Propriétés communes à tous les projets. Un paquet ne s'ajoute jamais ici : il s'ajoute au seul projet qui l'utilise.", "Properties shared by every project. A package is never added here: it goes to the single project that uses it.") %> -->
<Project>
  <PropertyGroup>
    <TargetFramework><%= it.versions.targetFramework %></TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- <%= it.d("Le mode invariant est incompatible avec Microsoft.Data.SqlClient, qui lève `Globalization Invariant Mode is not supported` à l'ouverture de la connexion. Il resterait donc à `true` pour PostgreSQL et à `false` pour SQL Server : deux projets par ailleurs identiques n'auraient pas la même comparaison de chaînes. Uniformément `false`, et l'image Docker fournit ICU.", "Invariant mode is incompatible with Microsoft.Data.SqlClient, which throws `Globalization Invariant Mode is not supported` when opening the connection. It would therefore stay `true` for PostgreSQL and become `false` for SQL Server: two otherwise identical projects would not compare strings the same way. Uniformly `false`, and the Docker image supplies ICU.") %> -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- <%= it.d("CORE-035 : un avertissement d'audit NuGet fait échouer le build.", "CORE-035: a NuGet audit warning fails the build.") %> -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- <%= it.d("Le style déclaré dans .editorconfig est vérifié à la compilation, pas seulement par l'IDE.", "The style declared in .editorconfig is checked at build time, not only by the IDE.") %> -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
<% for (const [key, value] of Object.entries(it.msbuild)) { -%>
  <PropertyGroup>
    <<%= key %>><%= value %></<%= key %>>
  </PropertyGroup>
<% } -%>
</Project>
