<% const kernel = it.projectFor('kernel'); -%>
namespace <%= kernel.namespace %>.Common;

<%= it.t("// CORE-011 : levée quand l'état demandé contredit l'état courant, traduite en 409.", "// CORE-011: thrown when the requested state contradicts the current one, translated to a 409.") %>
public sealed class ConflictException : Exception
{
    public ConflictException()
        : base("Conflicting state") { }

    public ConflictException(string message)
        : base(message) { }

    public ConflictException(string message, Exception innerException)
        : base(message, innerException) { }
}
