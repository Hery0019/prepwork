<% const kernel = it.projectFor('kernel'); -%>
namespace <%= kernel.namespace %>.Common;

<%= it.t("// CORE-011 : levée par le domaine, traduite en 404 par le handler unique. Le domaine ne", "// CORE-011: thrown by the domain, translated to a 404 by the single handler. The domain") %>
<%= it.t("// connaît aucun code de statut HTTP.", "// knows no HTTP status code.") %>
public sealed class NotFoundException : Exception
{
    public NotFoundException()
        : base("Resource not found") { }

    public NotFoundException(string message)
        : base(message) { }

    public NotFoundException(string message, Exception innerException)
        : base(message, innerException) { }
}
