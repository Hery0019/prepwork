<%
const host = it.projectFor('host');
const withDatabase = it.stack.database !== 'none';
const persistence = withDatabase ? it.projectFor('persistence') : null;
-%>
# <%= it.d("CIGH-001 : la CI ne fait rien de plus que ce qu'une machine de développement peut faire.", "CIGH-001: CI does nothing more than a development machine can do.") %>
name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      # <%= it.d("CIGH-002 : la version vient de global.json, jamais du workflow.", "CIGH-002: the version comes from global.json, never from the workflow.") %>
      - uses: actions/setup-dotnet@v5
        with:
          global-json-file: global.json

      - name: restore
        run: dotnet restore

      - name: format
        run: dotnet format --verify-no-changes --no-restore

      - name: build
        run: dotnet build --configuration Release --no-restore

      - name: test
        run: dotnet test --configuration Release --no-build
<% if (withDatabase) { -%>

      # <%= it.d("PERS-001 : un modèle modifié sans migration fait échouer la CI.", "PERS-001: a model changed without its migration fails CI.") %>
      - name: pending model changes
        run: |
          dotnet tool install --global dotnet-ef --version 10.0.11
          dotnet ef migrations has-pending-model-changes \
            --project <%= persistence.csproj %> \
            --startup-project <%= host.csproj %> \
            --no-build --configuration Release
<% } -%>
