<%
const persistence = it.projectFor('persistence');
const useProvider = it.stack.database === 'postgresql' ? 'UseNpgsql' : 'UseSqlServer';
-%>
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace <%= persistence.namespace %>.Persistence;

<%= it.t("// Point d'entrée de la persistance : `AddInfrastructure` l'appelle, et rien d'autre ne", "// The entry point of persistence: `AddInfrastructure` calls it, and nothing else knows") %>
<%= it.t("// connaît le `DbContext`.", "// about the `DbContext`.") %>
public static class PersistenceServices
{
    public static IServiceCollection AddPersistence(
        this IServiceCollection services,
        IConfiguration configuration
    )
    {
        ArgumentNullException.ThrowIfNull(services);
        ArgumentNullException.ThrowIfNull(configuration);

        <%= it.t("// PERS-003 : la chaîne vient de l'environnement. Absente, l'application refuse de", "// PERS-003: the string comes from the environment. Without it the application refuses") %>
        <%= it.t("// démarrer plutôt que de se rabattre sur une base locale silencieuse.", "// to start rather than falling back to a silent local database.") %>
        var connectionString =
            configuration["DB_CONNECTION_STRING"]
            ?? throw new InvalidOperationException(
                "DB_CONNECTION_STRING is not set (see .env.example)"
            );

        services.AddDbContext<AppDbContext>(options => options.<%= useProvider %>(connectionString));
        return services;
    }
}
