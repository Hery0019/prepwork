<% const domain = it.projects.find((candidate) => candidate.id === 'domain'); -%>
namespace <%= domain.namespace %>.Notes;

<%= it.t("/// <summary>Exemple de référence : une note de texte.</summary>", "/// <summary>Reference example: a text note.</summary>") %>
<%= it.t("// NET-005 : aucun attribut de persistance ni de sérialisation. Le mapping relationnel est", "// NET-005: no persistence or serialisation attribute. The relational mapping is declared") %>
<%= it.t("// déclaré dans la couche infrastructure, qui est la seule à connaître une base.", "// in the infrastructure layer, the only one that knows about a database.") %>
public sealed class Note
{
    <%= it.t("/// <summary>Requis par le mapping relationnel, qui matérialise sans passer par le constructeur.</summary>", "/// <summary>Required by the relational mapping, which materialises without the constructor.</summary>") %>
    private Note() { }

    public Note(string title, string body, DateTimeOffset createdAt)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(title);
        Title = title;
        Body = body ?? string.Empty;
        CreatedAt = createdAt;
    }

    public long Id { get; private set; }

    <%= it.t("/// <summary>Attribuée par l'adaptateur de persistance au premier enregistrement.</summary>", "/// <summary>Assigned by the persistence adapter when the note is first stored.</summary>") %>
    public void AssignIdentity(long id)
    {
        if (Id != 0)
        {
            throw new InvalidOperationException("Identity already assigned");
        }

        Id = id;
    }

    public string Title { get; private set; } = string.Empty;

    public string Body { get; private set; } = string.Empty;

    public DateTimeOffset CreatedAt { get; private set; }
}
