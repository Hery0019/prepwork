<%
const infrastructure = it.projects.find((candidate) => candidate.id === 'infrastructure');
const domain = it.projects.find((candidate) => candidate.id === 'domain');
const table = it.tables[0];
const identity = table.columns.find((column) => column.type === 'identity');
const others = table.columns
  .filter((column) => column.type !== 'identity')
  .sort((a, b) => it.propertyName(a).localeCompare(it.propertyName(b)));
const postgres = it.stack.database === 'postgresql';
const efVersion = it.projectFor('persistence').packages
  .find((nuget) => nuget.id === 'Microsoft.EntityFrameworkCore').version;
-%>
// <auto-generated />
using System;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
<% if (postgres) { -%>
using Npgsql.EntityFrameworkCore.PostgreSQL.Metadata;
<% } else { -%>
using Microsoft.EntityFrameworkCore.Metadata;
<% } -%>
using <%= infrastructure.namespace %>.Persistence;

#nullable disable

namespace <%= infrastructure.namespace %>.Migrations
{
    [DbContext(typeof(AppDbContext))]
    partial class AppDbContextModelSnapshot : ModelSnapshot
    {
        protected override void BuildModel(ModelBuilder modelBuilder)
        {
#pragma warning disable 612, 618
            modelBuilder
                .HasAnnotation("ProductVersion", "<%= efVersion %>")
                .HasAnnotation("Relational:MaxIdentifierLength", <%= postgres ? 63 : 128 %>);

<% if (postgres) { -%>
            NpgsqlModelBuilderExtensions.UseIdentityByDefaultColumns(modelBuilder);
<% } else { -%>
            SqlServerModelBuilderExtensions.UseIdentityColumns(modelBuilder);
<% } -%>

            modelBuilder.Entity("<%= domain.namespace %>.Notes.Note", b =>
                {
                    b.Property<<%= it.clrType(identity) %>>("<%= it.propertyName(identity) %>")
                        .ValueGeneratedOnAdd()
                        .HasColumnType("<%= it.efColumnType(identity) %>")
                        .HasColumnName("<%= identity.name %>");

<% if (postgres) { -%>
                    NpgsqlPropertyBuilderExtensions.UseIdentityByDefaultColumn(b.Property<<%= it.clrType(identity) %>>("<%= it.propertyName(identity) %>"));
<% } else { -%>
                    SqlServerPropertyBuilderExtensions.UseIdentityColumn(b.Property<<%= it.clrType(identity) %>>("<%= it.propertyName(identity) %>"));
<% } -%>
<% for (const column of others) { -%>

                    b.Property<<%= it.clrType(column) %>>("<%= it.propertyName(column) %>")
<% if (it.isReferenceType(column) && !column.nullable) { -%>
                        .IsRequired()
<% } -%>
                        .HasColumnType("<%= it.efColumnType(column) %>")
                        .HasColumnName("<%= column.name %>");
<% } -%>

                    b.HasKey("<%= it.propertyName(identity) %>");

                    b.ToTable("<%= table.name %>", (string)null);
                });
#pragma warning restore 612, 618
        }
    }
}
