#!/bin/sh
# <%= it.t('Hook commit-msg : Conventional Commits (GIT-001). Activé par `git config core.hooksPath .githooks`.', 'commit-msg hook: Conventional Commits (GIT-001). Enabled with `git config core.hooksPath .githooks`.') %>

message_file="$1"
first_line=$(head -n 1 "$message_file")

# <%= it.t("Les commits de fusion, de revert automatique et les fixup sont acceptés tels quels.", 'Merge commits, automatic reverts and fixups are accepted as they are.') %>
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].{0,71}$'
if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: <%= it.t("message refusé (GIT-001).", 'message rejected (GIT-001).') %>
  <%= it.t('Attendu', 'Expected') %> : type(scope): subject
  <%= it.t('Types', 'Types') %>   : feat fix docs style refactor perf test build ci chore revert
  <%= it.t('Reçu', 'Received') %>    : $first_line
EOF
exit 1
