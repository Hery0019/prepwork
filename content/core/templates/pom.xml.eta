<?xml version="1.0" encoding="UTF-8"?>
<!-- <%= it.d('Généré par prepwork ' + it.toolVersion + ' depuis scaffold.yaml. Ne pas éditer : modifier la source, puis `prepwork sync`.', 'Generated by prepwork ' + it.toolVersion + ' from scaffold.yaml. Do not edit: change the source, then run `prepwork sync`.') %> -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version><%= it.versions.springBoot %></version>
        <relativePath/>
    </parent>

    <groupId><%= it.project.groupId %></groupId>
    <artifactId><%= it.project.artifactId %></artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name><%= it.project.name %></name>
    <description><%= it.project.description %></description>

    <properties>
        <java.version><%= it.stack.java %></java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version><%= it.versions.archunit %></archunit.version>
        <spotless.version><%= it.versions.spotlessPlugin %></spotless.version>
<% for (const [key, value] of Object.entries(it.maven.properties)) { -%>
        <<%= key %>><%= value %></<%= key %>>
<% } -%>
    </properties>
<% if (it.maven.boms.length > 0) { -%>

    <dependencyManagement>
        <dependencies>
<% for (const bom of it.maven.boms) { -%>
            <dependency>
                <groupId><%= bom.group_id %></groupId>
                <artifactId><%= bom.artifact_id %></artifactId>
                <version><%= bom.version %></version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
<% } -%>
        </dependencies>
    </dependencyManagement>
<% } -%>

    <dependencies>
        <!-- <%= it.t('Socle : web, validation, supervision', 'Base: web, validation, monitoring') %> -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
<% if (it.stack.database !== 'none') { -%>

        <!-- <%= it.t('Persistance', 'Persistence') %> -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
<% if (it.stack.database === 'postgresql') { -%>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
<% } else if (it.stack.database === 'mysql') { -%>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
<% } else if (it.stack.database === 'oracle') { -%>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
<% } -%>
<% } else { -%>

        <!-- <%= it.t('Pagination sans base de données (Pageable, Page)', 'Pagination without a database (Pageable, Page)') %> -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
<% } -%>
<% const contributed = it.maven.dependencies.filter((d) => (d.scope ?? 'compile') !== 'test'); -%>
<% if (contributed.length > 0) { -%>

        <!-- <%= it.t('Contributions du profil et des options', 'Profile and option contributions') %> -->
<% for (const dep of contributed) { -%>
        <dependency>
            <groupId><%= dep.group_id %></groupId>
            <artifactId><%= dep.artifact_id %></artifactId>
<% if (dep.version) { -%>
            <version><%= dep.version %></version>
<% } -%>
<% if (dep.scope) { -%>
            <scope><%= dep.scope %></scope>
<% } -%>
<% if (dep.optional) { -%>
            <optional>true</optional>
<% } -%>
        </dependency>
<% } -%>
<% } -%>

        <!-- <%= it.t('Tests : unitaires, slices, intégration', 'Tests: unit, slices, integration') %> -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
<% if (it.stack.database !== 'none') { -%>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
<% if (it.stack.database === 'postgresql') { -%>
            <artifactId>testcontainers-postgresql</artifactId>
<% } else if (it.stack.database === 'mysql') { -%>
            <artifactId>testcontainers-mysql</artifactId>
<% } else { -%>
            <artifactId>testcontainers-oracle-free</artifactId>
<% } -%>
            <scope>test</scope>
        </dependency>
<% } -%>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
<% for (const dep of it.maven.dependencies.filter((d) => d.scope === 'test')) { -%>
        <dependency>
            <groupId><%= dep.group_id %></groupId>
            <artifactId><%= dep.artifact_id %></artifactId>
<% if (dep.version) { -%>
            <version><%= dep.version %></version>
<% } -%>
            <scope>test</scope>
        </dependency>
<% } -%>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- <%= it.t('Tests unitaires et slices (*Test) avec le profil Spring `test`', 'Unit and slice tests (*Test) with the `test` Spring profile') %> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- <%= it.t('Tests d\'intégration (*IT) : `./mvnw verify`', 'Integration tests (*IT): `./mvnw verify`') %> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- <%= it.t('Formatage : `./mvnw spotless:apply` avant chaque commit ; `verify` échoue sinon', 'Formatting: `./mvnw spotless:apply` before every commit; `verify` fails otherwise') %> -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat/>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
