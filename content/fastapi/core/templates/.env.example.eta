# <%= it.d("Copier en `.env` et remplir. `.env` est ignoré par git ; ce fichier-ci est commité (CORE-030).", "Copy to `.env` and fill in. `.env` is git-ignored; this file is committed (CORE-030).") %>

# <%= it.d("local | staging | production. Hors `local`, la documentation interactive n'est pas servie (CORE-036).", "local | staging | production. Outside `local`, the interactive documentation is not served (CORE-036).") %>
APP_ENV=local

# <%= it.d("Origines autorisées, séparées par des virgules. Jamais `*` en production (CORE-033).", "Allowed origins, comma-separated. Never `*` in production (CORE-033).") %>
CORS_ORIGINS=["http://localhost:5173"]
<% for (const variable of it.env) { %>
# <%= it.text(variable.comment) %>
<%= variable.name %>=<%= it.extras.envOverrides?.[variable.name] ?? variable.example %>
<% } -%>
