<%
const pkg = it.project.packageName;
-%>
# <%= it.d("Généré par prepwork. Les dépendances viennent du catalogue : `uv add` puis reporter dans la source.", "Generated by prepwork. Dependencies come from the catalogue: `uv add`, then carry the change back to the source.") %>
[project]
name = "<%= it.project.name %>"
version = "0.1.0"
description = "<%= it.project.description %>"
requires-python = "==<%= it.versions.python %>.*"
dependencies = [
<% for (const dep of it.python.dependencies) { -%>
    "<%= dep.id %>==<%= dep.version %>",
<% } -%>
]

[dependency-groups]
dev = [
<% for (const dep of it.python.devDependencies) { -%>
    "<%= dep.id %>==<%= dep.version %>",
<% } -%>
]

# <%= it.d("Layout `src/` : les tests importent le paquet installé, pas le répertoire courant.", "`src/` layout: tests import the installed package, not the working directory.") %>
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/<%= pkg %>"]

# <%= it.d("CORE-053 : le lint et le format sont un seul outil, et la configuration vit ici.", "CORE-053: lint and format are a single tool, and the configuration lives here.") %>
[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "A", "C4", "SIM", "RUF"]

# <%= it.d("Un test porte l'identifiant de la règle qu'il prouve — `test_CORE_011_...` —, et c'est cette convention que le contrôle de cohérence du catalogue vérifie. Les majuscules d'un identifiant priment donc sur N802, et seulement dans les tests.", "A test carries the identifier of the rule it proves — `test_CORE_011_...` — and that convention is what the catalogue consistency check verifies. An identifier's capitals therefore win over N802, and only in tests.") %>
[tool.ruff.lint.per-file-ignores]
"tests/**" = ["N802"]

# <%= it.d("CORE-050 : le typage strict tient ici le rôle du compilateur. Aucun module n'est exclu (CORE-AP-051).", "CORE-050: strict typing plays the compiler role here. No module is excluded (CORE-AP-051).") %>
[tool.mypy]
python_version = "<%= it.versions.python %>"
strict = true
files = ["src", "tests"]

# <%= it.d("CORE-023 : un marqueur de niveau par test ; `-m \"not integration\"` est ce qui tourne sans Docker.", "CORE-023: one level marker per test; `-m \"not integration\"` is what runs without Docker.") %>
[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
markers = [
    "unit: <%= it.d("niveau unitaire, sans application", "unit level, no application") %>",
    "slice: <%= it.d("niveau slice, application avec la couche service doublée", "slice level, application with the service layer substituted") %>",
    "integration: <%= it.d("niveau intégration, Testcontainers sur la vraie base", "integration level, Testcontainers on the real database") %>",
]
