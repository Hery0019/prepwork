"""<%= it.t("Racine de composition : assemble le framework, puis délègue.", "Composition root: assembles the framework, then delegates.") %>

<%= it.t("Deux contrats tenus par convention de nom, jamais par une", "Two contracts held by naming convention, never by a") %>
<%= it.t("référence croisée : `configure_security` vient toujours d'une", "cross-reference: `configure_security` always comes from a") %>
<%= it.t("option `security-*`, `register_routes` toujours du profil.", "`security-*` option, `register_routes` always from the profile.") %>
<%= it.t("Aucun des deux axes ne nomme l'autre.", "Neither of the two axes names the other.") %>
"""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from <%= it.moduleFor('host').module %> import health
from <%= it.moduleFor('host').module %>.errors import register_error_handlers
from <%= it.moduleFor('host').module %>.middleware import SecurityHeadersMiddleware
from <%= it.moduleFor('host').module %>.routes import register_routes
from <%= it.moduleFor('host').module %>.security import configure_security
from <%= it.moduleFor('host').module %>.settings import Settings, get_settings

# CORE-016 : <%= it.t("versionné dès le premier jour ; versionner coûte peu maintenant et beaucoup après.", "versioned from day one; versioning is cheap now and expensive later.") %>
API_PREFIX = "/api/v1"


def create_app(settings: Settings | None = None) -> FastAPI:
    """<%= it.t("Assemble l'application. Les tests appellent cette fonction avec leurs propres réglages.", "Assembles the application. Tests call this function with their own settings.") %>"""
    resolved = settings or get_settings()
    app = FastAPI(
        title="<%= it.project.name %>",
        # CORE-036 : <%= it.t("la documentation interactive n'est pas servie en production.", "the interactive documentation is not served in production.") %>
        docs_url="/docs" if resolved.docs_enabled else None,
        openapi_url="/openapi.json" if resolved.docs_enabled else None,
    )
    app.state.settings = resolved

    app.add_middleware(SecurityHeadersMiddleware)
    app.add_middleware(
        CORSMiddleware,
        allow_origins=resolved.cors_origins,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    configure_security(app)
    register_error_handlers(app)
    app.include_router(health.router, prefix=API_PREFIX)
    register_routes(app, API_PREFIX)
    return app
