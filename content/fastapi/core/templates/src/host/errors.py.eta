"""<%= it.t("Traduction des exceptions en documents RFC 9457 (CORE-010, CORE-011, CORE-012).", "Translation of exceptions into RFC 9457 documents (CORE-010, CORE-011, CORE-012).") %>

<%= it.t("FastAPI ne fournit rien de tel : ses erreurs de validation sortent", "FastAPI ships nothing of the sort: its validation errors come out") %>
<%= it.t("en 422 sous une forme qui lui est propre. Ce module est donc du", "as 422 in a shape of its own. This module is therefore skeleton") %>
<%= it.t("code de squelette, et le seul endroit qui choisit un statut.", "code, and the only place that picks a status code.") %>
"""

import logging
from typing import Any

from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse

from <%= it.moduleFor('kernel').module %>.exceptions import ConflictError, NotFoundError

PROBLEM_MEDIA_TYPE = "application/problem+json"

logger = logging.getLogger(__name__)


def _problem(status: int, title: str, detail: str, **extra: Any) -> JSONResponse:
    body: dict[str, Any] = {
        "type": "about:blank",
        "title": title,
        "status": status,
        "detail": detail,
    }
    body.update(extra)
    return JSONResponse(status_code=status, content=body, media_type=PROBLEM_MEDIA_TYPE)


def register_error_handlers(app: FastAPI) -> None:
    """<%= it.t("Enregistre les quatre traductions. Un seul appel, dans la racine de composition.", "Registers the four translations. A single call, in the composition root.") %>"""

    @app.exception_handler(RequestValidationError)
    async def _validation(_request: Request, error: RequestValidationError) -> JSONResponse:
        # CORE-012 : <%= it.t("le 422 par défaut de FastAPI ferait parler deux dialectes d'erreur à l'API.", "FastAPI's default 422 would make the API speak two error dialects.") %>
        errors = [
            {"field": ".".join(str(part) for part in issue["loc"][1:]), "message": issue["msg"]}
            for issue in error.errors()
        ]
        return _problem(
            400,
            "Validation failed",
            "<%= it.t("Une ou plusieurs valeurs envoyées sont invalides.", "One or more submitted values are invalid.") %>",
            errors=errors,
        )

    @app.exception_handler(NotFoundError)
    async def _not_found(_request: Request, error: NotFoundError) -> JSONResponse:
        return _problem(404, "Not found", str(error))

    @app.exception_handler(ConflictError)
    async def _conflict(_request: Request, error: ConflictError) -> JSONResponse:
        return _problem(409, "Conflict", str(error))

    @app.exception_handler(Exception)
    async def _unexpected(_request: Request, error: Exception) -> JSONResponse:
        # CORE-037 : <%= it.t("le traceback va dans les logs, jamais dans la réponse.", "the traceback goes to the logs, never into the response.") %>
        logger.exception("unhandled error", exc_info=error)
        return _problem(
            500,
            "Internal server error",
            "<%= it.t("Une erreur inattendue est survenue.", "An unexpected error occurred.") %>",
        )
