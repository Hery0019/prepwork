"""<%= it.t("Le seul endpoint de diagnostic exposé (CORE-032).", "The only diagnostic endpoint exposed (CORE-032).") %>"""

from fastapi import APIRouter

router = APIRouter(tags=["health"])


@router.get("/health")
async def read_health() -> dict[str, str]:
    """<%= it.t("Ne renvoie ni configuration, ni environnement, ni dump : ce serait une fuite.", "Returns neither configuration, nor environment, nor dumps: that would be a leak.") %>"""
    return {"status": "up"}
