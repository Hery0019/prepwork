<%
// Chaque variable déclarée par une option devient un champ requis : une valeur absente échoue
// au démarrage, pas à la première requête (CORE-030). Le socle ignore la source de chacune.
// Attention : Eta suit les guillemets dans un bloc de code, donc une apostrophe isolée dans un
// commentaire ouvre une chaîne qui ne se ferme jamais.
const field = (name) => name.toLowerCase();
-%>
"""<%= it.t("Réglages typés lus depuis l'environnement (CORE-030).", "Typed settings read from the environment (CORE-030).") %>

<%= it.t("Un champ sans défaut fait échouer le démarrage quand la variable manque,", "A field with no default fails startup when the variable is missing,") %>
<%= it.t("plutôt que la première requête qui en a besoin.", "rather than the first request that needs it.") %>
"""

from functools import lru_cache
from typing import Literal

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """<%= it.t("Tout ce qui diffère d'un environnement à l'autre, et rien d'autre.", "Everything that differs from one environment to the next, and nothing else.") %>"""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    app_env: Literal["local", "staging", "production"] = "local"
    # CORE-033 : <%= it.t("liste explicite, jamais `*` hors développement local.", "an explicit list, never `*` outside local development.") %>
    cors_origins: list[str] = []
<% for (const variable of it.env) { -%>
    <%= field(variable.name) %>: str
<% } -%>

    @property
    def docs_enabled(self) -> bool:
        """CORE-036 : <%= it.t("`/docs` publie chaque route et chaque champ à qui le demande.", "`/docs` publishes every route and every field to anyone who asks.") %>"""
        return self.app_env != "production"


@lru_cache
def get_settings() -> Settings:
    """<%= it.t("Une seule instance par processus ; les tests passent la leur à `create_app`.", "One instance per process; tests pass their own to `create_app`.") %>"""
<% if (it.env.length > 0) { -%>
    # <%= it.t("Les valeurs viennent de l'environnement : mypy ne le sait pas, pydantic-settings si.", "The values come from the environment: mypy does not know that, pydantic-settings does.") %>
    return Settings()  # type: ignore[call-arg]
<% } else { -%>
    return Settings()
<% } -%>
