"""<%= it.t("Enveloppe de pagination commune à tous les endpoints de liste (CORE-015).", "Pagination envelope shared by every list endpoint (CORE-015).") %>"""

from dataclasses import dataclass

# <%= it.t("Le socle place ce fichier par un rôle : il ignore les couches du profil.", "The core places this file by role: it knows nothing of the profile's layers.") %>


@dataclass(frozen=True, slots=True)
class Page[T]:
    """<%= it.t("Une page de résultats et son total, tels que l'API les expose.", "A page of results and its total, as the API exposes them.") %>"""

    content: list[T]
    page: int
    size: int
    total_elements: int
