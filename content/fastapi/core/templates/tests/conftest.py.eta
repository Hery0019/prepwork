@pytest.fixture
async def client(settings: Settings) -> AsyncIterator[AsyncClient]:
    """<%= it.t("Niveau slice : l'application est appelée par `ASGITransport`, sans socket réseau.", "Slice level: the application is called through `ASGITransport`, with no network socket.") %>"""
