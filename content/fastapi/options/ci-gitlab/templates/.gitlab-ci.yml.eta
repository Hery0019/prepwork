# <%= it.d("CIGL-001 : la CI exécute exactement ce qu'un développeur peut lancer localement.", "CIGL-001: CI runs exactly what a developer can run locally.") %>
image: ghcr.io/astral-sh/uv:<%= it.versions.uv %>-python<%= it.versions.python %>-bookworm-slim

variables:
  UV_CACHE_DIR: .uv-cache

cache:
  key:
    files:
      - uv.lock
  paths:
    - .uv-cache

default:
  before_script:
    - uv sync --frozen

stages:
  - check
  - test

lint:
  stage: check
  script:
    - uv run ruff format --check .
    - uv run ruff check .
    - uv run mypy
    - uv run pip-audit

# <%= it.d("CIGL-002 : job à part entière — un échec doit nommer le contrat de couches.", "CIGL-002: a job of its own — a failure must name the layer contract.") %>
layer-contract:
  stage: check
  script:
    - uv run lint-imports

test:
  stage: test
<% if (it.stack.database !== 'none') { -%>
  # <%= it.d("CIGL-003 : sans ce service le niveau intégration serait rouge, jamais silencieusement ignoré.", "CIGL-003: without this service the integration level would be red, never silently skipped.") %>
  services:
    - name: docker:27-dind
      alias: docker
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
    TESTCONTAINERS_RYUK_DISABLED: "true"
<% } -%>
  script:
    - uv run pytest
