"""PERS-001 : <%= it.t("la migration livrée décrit exactement le modèle.", "the shipped migration describes the model exactly.") %>

<%= it.t("`alembic check` exige une base vivante — contrairement à son équivalent EF Core —", "`alembic check` needs a live database — unlike its EF Core counterpart —") %>
<%= it.t("donc ce contrôle appartient au niveau intégration, pas au pipeline hors Docker.", "so this check belongs to the integration level, not to the Docker-free pipeline.") %>
"""

import pytest
from alembic import command
from alembic.config import Config
from alembic.util.exc import AutogenerateDiffsDetected


@pytest.mark.integration
def test_the_shipped_migration_matches_the_model(database_url: str) -> None:
    """<%= it.t("Un écart ici est un faux diff à la prochaine migration, pas une erreur visible.", "A gap here is a false diff at the next migration, not a visible error.") %>"""
    try:
        command.check(Config("alembic.ini"))
    except AutogenerateDiffsDetected as difference:  # pragma: no cover
        pytest.fail(f"<%= it.t("le modèle et les migrations divergent", "the model and the migrations diverge") %> : {difference}")
