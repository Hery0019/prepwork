"""<%= it.t("SECN-003 : l'absence d'authentification est explicite, pas partielle.", "SECN-003: the absence of authentication is explicit, not partial.") %>"""

from pathlib import Path

import pytest

PACKAGE = Path("src") / "<%= it.project.packageName %>"


@pytest.mark.unit
def test_SECN_003_no_module_imports_fastapi_security() -> None:
    """<%= it.t("Une sécurité partielle est pire qu'une absence : on la croit là.", "Partial security is worse than none: people believe it is there.") %>"""
    offenders = [
        path
        for path in PACKAGE.rglob("*.py")
        if "fastapi.security" in path.read_text(encoding="utf-8")
    ]
    assert offenders == [], f"{offenders} — <%= it.t("changer d'option (SECN-003)", "switch option (SECN-003)") %>"
