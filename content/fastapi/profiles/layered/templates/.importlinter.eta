<%
const pkg = it.project.packageName;
// Le contrat `layers` se lit de la couche haute vers la basse : l'inverse de l'ordre du
// catalogue, qui part de celle qui ne dépend de rien.
const highToLow = [...it.layers].reverse();
-%>
; <%= it.d("Généré par prepwork. Python n'a pas de compilateur : ce fichier est la seule chose qui tient les frontières de couches. Une entrée `ignore_imports` ajoutée pour débloquer un build supprime l'architecture en silence (PY-AP-002).", "Generated by prepwork. Python has no compiler: this file is the only thing holding the layer boundaries. An `ignore_imports` entry added to unblock a build deletes the architecture quietly (PY-AP-002).") %>
[importlinter]
root_package = <%= pkg %>
; <%= it.d("Obligatoire : PY-003 à PY-005 interdisent des paquets externes (fastapi, sqlalchemy). Sans cette ligne, import-linter refuse de vérifier ces contrats.", "Required: PY-003 to PY-005 forbid external packages (fastapi, sqlalchemy). Without this line, import-linter refuses to check those contracts.") %>
include_external_packages = True

; <%= it.d("PY-001 — la règle sur laquelle repose toute l'architecture. Les couches viennent du bloc `architecture.layers` du profil : c'est le seul endroit où leur ordre est écrit une deuxième fois.", "PY-001 — the rule the whole architecture rests on. The layers come from the profile's `architecture.layers` block: the only place where their order is written a second time.") %>
[importlinter:contract:PY_001]
name = PY_001 layers
type = layers
layers =
<% for (const layer of highToLow) { -%>
    <%= layer.id %>
<% } -%>
containers =
    <%= pkg %>

; <%= it.d("PY-002 n'est pas ici : la racine de composition doit nommer le dépôt pour câbler la session, donc `api` → `repository` reste autorisé par le contrat de couches. Ce qu'il faut borner — que la racine soit le seul à le faire — est un test, pas un contrat.", "PY-002 is not here: the composition root must name the repository to wire the session, so `api` → `repository` stays allowed by the layer contract. What has to be bounded — that the root is the only one doing it — is a test, not a contract.") %>

[importlinter:contract:PY_003]
name = PY_003 domain is free of the web framework
type = forbidden
source_modules =
    <%= pkg %>.domain
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:PY_004]
name = PY_004 service has no fastapi symbol
type = forbidden
source_modules =
    <%= pkg %>.service
forbidden_modules =
    fastapi
    starlette

; <%= it.d("PY-005 — `sqlalchemy` reste permis à `domain`, qui déclare son mapping (PY-003) ; seule la construction d'instructions est bornée à `repository`.", "PY-005 — `sqlalchemy` stays allowed in `domain`, which declares its mapping (PY-003); only statement building is confined to `repository`.") %>
[importlinter:contract:PY_005]
name = PY_005 only repository builds statements
type = forbidden
; <%= it.d("`api` n'est pas listé : la racine de composition doit nommer le type de session pour câbler la dépendance de requête. Ce qui la borne est le test de PY-002, pas ce contrat.", "`api` is not listed: the composition root must name the session type to wire the request dependency. What bounds it is the PY-002 test, not this contract.") %>
source_modules =
    <%= pkg %>.service
forbidden_modules =
    sqlalchemy
; <%= it.d("Imports directs seulement : PY-003 autorise `domain` à porter son mapping, donc toute couche atteint `sqlalchemy` à travers l'entité. Sans cette ligne le contrat serait rompu par construction, et la seule issue serait d'exclure des imports — ce que PY-AP-002 interdit.", "Direct imports only: PY-003 lets `domain` carry its mapping, so every layer reaches `sqlalchemy` through the entity. Without this line the contract would be broken by construction, and the only way out would be ignoring imports — which PY-AP-002 forbids.") %>
allow_indirect_imports = True
