"""<%= it.t("Cas d'usage des notes. PY-004 : aucun symbole `fastapi`, `HTTPException` compris.", "Note use cases. PY-004: no `fastapi` symbol, `HTTPException` included.") %>"""

from <%= it.moduleFor('kernel').module %>.exceptions import NotFoundError
from <%= it.moduleFor('kernel').module %>.note import Note
from <%= it.moduleFor('kernel').module %>.pagination import Page
from <%= it.modules.find((m) => m.id === 'repository').module %>.note_repository import NoteRepository

MAX_PAGE_SIZE = 100


class NoteService:
    """<%= it.t("Le dépôt est reçu en paramètre : le service se teste sans base ni application.", "The repository is received as a parameter: the service tests without a database or an application.") %>"""

    def __init__(self, repository: NoteRepository) -> None:
        self._repository = repository

    async def create(self, title: str, body: str | None) -> Note:
        return await self._repository.add(title, body)

    async def get(self, note_id: int) -> Note:
        note = await self._repository.find(note_id)
        if note is None:
            # PY-008 : <%= it.t("jamais `None` pour dire « introuvable » ; le gestionnaire traduit en 404.", "never `None` to mean \"not found\"; the handler translates it to a 404.") %>
            raise NotFoundError("Note", note_id)
        return note

    async def list(self, page: int, size: int) -> Page[Note]:
        bounded = min(max(size, 1), MAX_PAGE_SIZE)
        content, total = await self._repository.page(max(page, 0), bounded)
        return Page(content=content, page=max(page, 0), size=bounded, total_elements=total)
