"""<%= it.t("Règles du profil `layered` que le contrat `import-linter` ne sait pas dire.", "Rules of the `layered` profile that the `import-linter` contract cannot express.") %>

<%= it.t("Le contrat borne les imports ; il ne dit rien de ce qu'un module", "The contract bounds imports; it says nothing about what a module") %>
<%= it.t("construit à l'import, ni du nombre de racines de composition.", "builds at import time, nor about how many composition roots exist.") %>
"""

import ast
from pathlib import Path

import pytest

PACKAGE = Path("src") / "<%= it.project.packageName %>"


def _module_sources() -> list[tuple[Path, str]]:
    return [(path, path.read_text(encoding="utf-8")) for path in PACKAGE.rglob("*.py")]


@pytest.mark.unit
def test_PY_002_only_the_composition_root_imports_the_repository() -> None:
    """<%= it.t("La racine nomme le dépôt pour câbler la session ; les autres non.", "The root names the repository to wire the session; the others do not.") %>"""
    # <%= it.t("Deux modules forment la racine : `app.py` assemble le framework,", "Two modules form the root: `app.py` assembles the framework,") %>
    # <%= it.t("`dependencies.py` câble les fonctionnalités. C'est l'équivalent", "`dependencies.py` wires the features. It is the counterpart of") %>
    # <%= it.t("de `Program` et des méthodes `Add*` côté ASP.NET.", "`Program` and the `Add*` methods on the ASP.NET side.") %>
    composition_root = {"app.py", "dependencies.py"}
    repository = "<%= it.project.packageName %>.repository"
    offenders = [
        path
        for path, source in _module_sources()
        if path.parent.name == "api" and path.name not in composition_root and repository in source
    ]
    assert offenders == [], f"{offenders} (PY-002)"


@pytest.mark.unit
def test_PY_006_no_module_builds_an_engine_at_import_time() -> None:
    """<%= it.t("Un moteur construit à l'import ne peut pas être remplacé dans un test.", "An engine built at import time cannot be replaced in a test.") %>"""
    builders = {"create_async_engine", "async_sessionmaker", "sessionmaker"}
    for path, source in _module_sources():
        tree = ast.parse(source)
        for node in tree.body:  # <%= it.t("uniquement le niveau module : dans une fonction, c'est légitime.", "module level only: inside a function it is legitimate.") %>
            for called in ast.walk(node):
                if isinstance(called, ast.Call) and isinstance(called.func, ast.Name):
                    assert called.func.id not in builders, f"{path} (PY-006)"


@pytest.mark.unit
def test_PY_007_a_single_module_imports_every_layer() -> None:
    """<%= it.t("La racine de composition est unique : un seul fichier à lire pour savoir ce qui est câblé.", "The composition root is unique: a single file to read to know what is wired.") %>"""
    layers = {<%~ it.layers.map((l) => `"${l.id}"`).join(', ') %>}
    roots = []
    for path, source in _module_sources():
        imported = {
            alias.split(".")[-1]
            for node in ast.walk(ast.parse(source))
            if isinstance(node, ast.ImportFrom) and node.module
            for alias in [node.module]
        }
        if layers <= imported:
            roots.append(path)
    assert len(roots) <= 1, f"plusieurs racines de composition : {roots} (PY-007)"
