package <%= it.project.basePackage %>.common;

import org.springframework.boot.context.properties.ConfigurationProperties;

/**
 * <%= it.t("Réglages de sécurité (`app.security`) : interrupteur et administrateur initial lus depuis les variables d'environnement (SECS-002).", "Security settings (`app.security`): switch and bootstrap administrator read from environment variables (SECS-002).") %>
 */
@ConfigurationProperties(prefix = "app.security")
