package <%= it.project.basePackage %>.repository;

import <%= it.project.basePackage %>.domain.Note;
import java.util.Optional;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;

/**
 * <%= it.t("Accès aux notes : même contrat que Spring Data, sans base de données (LAY-004).", "Access to notes: same contract as Spring Data, without a database (LAY-004).") %>
