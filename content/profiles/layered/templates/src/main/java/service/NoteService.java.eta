package <%= it.project.basePackage %>.service;

import <%= it.project.basePackage %>.domain.Note;
import <%= it.project.basePackage %>.domain.NoteNotFoundException;
import <%= it.project.basePackage %>.repository.NoteRepository;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;
<% if (it.stack.database !== 'none') { -%>
import org.springframework.transaction.annotation.Transactional;
<% } -%>

/**
 * <%= it.t("Cas d'usage autour des notes. Le service est l'unité de travail (LAY-005) et renvoie des objets du domaine : la conversion en DTO se fait dans `web` (LAY-010).", "Use cases around notes. The service is the unit of work (LAY-005) and returns domain objects: mapping to DTOs happens in `web` (LAY-010).") %>
 */
@Service
public class NoteService {

    private final NoteRepository repository;

    public NoteService(NoteRepository repository) {
        this.repository = repository;
    }

<% if (it.stack.database !== 'none') { -%>
    @Transactional
<% } -%>
    public Note create(String title, String content) {
        return repository.save(new Note(title, content));
    }

<% if (it.stack.database !== 'none') { -%>
    @Transactional(readOnly = true)
<% } -%>
    public Note get(Long id) {
        return repository.findById(id).orElseThrow(() -> new NoteNotFoundException(id));
    }

<% if (it.stack.database !== 'none') { -%>
    @Transactional(readOnly = true)
<% } -%>
    public Page<Note> list(Pageable pageable) {
        return repository.findAll(pageable);
    }
}
