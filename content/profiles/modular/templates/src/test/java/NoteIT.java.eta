package <%= it.project.basePackage %>;

import static org.assertj.core.api.Assertions.assertThat;

import <%= it.project.basePackage %>.audit.AuditLog;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
<% if (it.stack.database !== 'none') { -%>
import org.springframework.context.annotation.Import;
<% } -%>
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.assertj.MockMvcTester;
import org.springframework.test.web.servlet.assertj.MvcTestResult;

/**
 * <%= it.t("Niveau intégration (CORE-020) : contexte complet" + (it.stack.database !== 'none' ? " et vraie base via Testcontainers (CORE-021)" : "") + ". Vérifie aussi que l'événement NoteCreated traverse la frontière de module (MOD-005).", "Integration level (CORE-020): full context" + (it.stack.database !== 'none' ? " and real database through Testcontainers (CORE-021)" : "") + ". Also verifies that the NoteCreated event crosses the module boundary (MOD-005).") %>
 */
@SpringBootTest
@AutoConfigureMockMvc
<% if (it.stack.database !== 'none') { -%>
@Import(TestcontainersConfiguration.class)
<% } -%>
class NoteIT {

    @Autowired
    private MockMvcTester mvc;

    @Autowired
    private AuditLog auditLog;

    @Test
    void create_thenGet_roundTripsAndNotifiesTheAuditModule() {
        long before = auditLog.createdNotes();
        MvcTestResult created = mvc.post()
                .uri("/api/v1/notes")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"title\": \"First\", \"content\": \"Hello\"}")
                .exchange();
        assertThat(created).hasStatus(HttpStatus.CREATED);

        String location = created.getResponse().getHeader("Location");
        assertThat(location).startsWith("/api/v1/notes/");
        assertThat(mvc.get().uri(location))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.title")
                .isEqualTo("First");
        assertThat(auditLog.createdNotes()).isEqualTo(before + 1);
    }

    @Test
    void list_defaultPage_returnsPaginatedShape() {
        assertThat(mvc.get().uri("/api/v1/notes?page=0&size=5"))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.size")
                .isEqualTo(5);
    }
}
