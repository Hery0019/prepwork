# <%= it.t("Variables d'environnement de l'application (CORE-046). Copier en `.env`, jamais commiter `.env`.", "Environment variables of the application (CORE-046). Copy to `.env`, never commit `.env`.") %>
<% if (it.profile === 'next-app') { -%>
# <%= it.t("Tout ce qui est préfixé NEXT_PUBLIC_ part dans le bundle et est donc public (CORE-070) ;", "Anything prefixed with NEXT_PUBLIC_ ships in the bundle and is therefore public (CORE-070);") %>
# <%= it.t("le reste ne quitte jamais le serveur (NEXT-010).", "the rest never leaves the server (NEXT-010).") %>

API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=<%= it.project.name %>
<% } else { -%>
# <%= it.t("Tout ce qui est préfixé VITE_ part dans le bundle et est donc public (CORE-070).", "Anything prefixed with VITE_ ships in the bundle and is therefore public (CORE-070).") %>

VITE_API_BASE_URL=http://localhost:8080/api/v1
<% } -%>
<% it.env.forEach(function (variable) { -%>

# <%= it.text(variable.comment) %>
<%= variable.name %>=<%= (it.extras.envOverrides || {})[variable.name] || variable.example %>
<% }) -%>
