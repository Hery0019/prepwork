<!doctype html>
<html lang="<%= it.language.docs %>" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= it.project.name %></title>
    <meta name="description" content="<%= it.project.description %>" />
  </head>
  <body>
    <div id="root"></div>
<% if (it.options.docker) { -%>
    <script src="/runtime-config.js"></script>
<% } -%>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
