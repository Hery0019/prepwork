<%= it.t("// Providers de l'application : ce fichier est le seul endroit qui connaît les choix de stack.", "// Application providers: the only file that knows about the stack choices.") %>
import type { ReactNode } from 'react';
import { BrowserRouter } from 'react-router';
<% if (it.stack.data === 'tanstack-query') { -%>
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
<% } -%>
<% if (it.options.i18n) { -%>
import { I18nextProvider } from 'react-i18next';
import { i18n } from '@shared/i18n/config';
<% } -%>

<% if (it.stack.data === 'tanstack-query') { -%>
<%= it.t("// QRY-001 : le cache serveur appartient à la bibliothèque, pas à un état local.", "// QRY-001: the server cache belongs to the library, not to local state.") %>
const queryClient = new QueryClient({
  defaultOptions: { queries: { staleTime: 30_000, retry: 1 } },
});

<% } -%>
export function Providers({ children }: { children: ReactNode }) {
  return (
<% if (it.options.i18n) { -%>
    <I18nextProvider i18n={i18n}>
<% } -%>
<% if (it.stack.data === 'tanstack-query') { -%>
      <QueryClientProvider client={queryClient}>
<% } -%>
        <BrowserRouter>{children}</BrowserRouter>
<% if (it.stack.data === 'tanstack-query') { -%>
      </QueryClientProvider>
<% } -%>
<% if (it.options.i18n) { -%>
    </I18nextProvider>
<% } -%>
  );
}
