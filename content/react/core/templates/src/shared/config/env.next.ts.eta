<%= it.t("// CORE-046 : toute valeur d'environnement est lue ici, validée, et nulle part ailleurs.", "// CORE-046: every environment value is read here, validated, and nowhere else.") %>
<%= it.t("// CORE-070 : seules les variables `NEXT_PUBLIC_*` atteignent le navigateur ; les autres", "// CORE-070: only `NEXT_PUBLIC_*` variables reach the browser; the others stay on the") %>
<%= it.t("// restent côté serveur et ne sont lisibles que dans un composant serveur ou une action.", "// server and are readable only from a server component or an action.") %>
import { z } from 'zod';

const PublicEnvSchema = z.object({
  NEXT_PUBLIC_APP_NAME: z.string().min(1),
<% if (it.options.security === "oidc-bff") { -%>
  NEXT_PUBLIC_AUTH_LOGIN_PATH: z.string().startsWith('/'),
<% } -%>
});

const ServerEnvSchema = z.object({
  API_BASE_URL: z.string().url(),
});

function parse<T>(schema: z.ZodType<T>, source: unknown, scope: string): T {
  const result = schema.safeParse(source);
  if (!result.success) {
    throw new Error(
      <%= it.t('`Variables d\'environnement ${scope} manquantes ou invalides : `', '`Missing or invalid ${scope} environment variables: `') %> +
        result.error.issues.map((issue) => issue.path.join('.')).join(', '),
    );
  }
  return result.data;
}

<%= it.t("/** Lisible partout, y compris dans le navigateur. */", "/** Readable everywhere, including in the browser. */") %>
export const publicEnv = parse(
  PublicEnvSchema,
  {
    NEXT_PUBLIC_APP_NAME: process.env.NEXT_PUBLIC_APP_NAME,
<% if (it.options.security === "oidc-bff") { -%>
    NEXT_PUBLIC_AUTH_LOGIN_PATH: process.env.NEXT_PUBLIC_AUTH_LOGIN_PATH,
<% } -%>
  },
  'publiques',
);

<%= it.t("/** Ne doit être appelé que depuis un composant serveur, une action ou un route handler. */", "/** Must be called only from a server component, an action or a route handler. */") %>
export function serverEnv() {
  return parse(ServerEnvSchema, { API_BASE_URL: process.env.API_BASE_URL }, 'serveur');
}
