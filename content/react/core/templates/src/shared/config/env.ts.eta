<%= it.t("// CORE-046 : toute valeur d'environnement est lue ici, validée, et nulle part ailleurs.", "// CORE-046: every environment value is read here, validated, and nowhere else.") %>
import { z } from 'zod';

const EnvSchema = z.object({
  VITE_API_BASE_URL: z.string().url(),
<% if (it.options.security === 'oidc-bff') { -%>
  VITE_AUTH_LOGIN_PATH: z.string().startsWith('/'),
<% } -%>
});

<% if (it.options.docker && it.config.build.kind === 'static') { -%>
declare global {
  interface Window {
    __RUNTIME_CONFIG__?: Record<string, string>;
  }
}

<%= it.t("// DOCK-003 : la configuration injectée au démarrage du conteneur prime sur celle du build.", "// DOCK-003: the configuration injected at container start wins over the build-time one.") %>
const source = { ...import.meta.env, ...(window.__RUNTIME_CONFIG__ ?? {}) };
<% } else { -%>
const source = import.meta.env;
<% } -%>

const parsed = EnvSchema.safeParse(source);
if (!parsed.success) {
  throw new Error(
    <%= it.t('"Variables d\'environnement manquantes ou invalides : "', '"Missing or invalid environment variables: "') %> +
      parsed.error.issues.map((issue) => issue.path.join('.')).join(', '),
  );
}

export const env = {
  apiBaseUrl: parsed.data.VITE_API_BASE_URL,
<% if (it.options.security === 'oidc-bff') { -%>
  authLoginPath: parsed.data.VITE_AUTH_LOGIN_PATH,
<% } -%>
} as const;
