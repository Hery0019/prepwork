<%= it.t("// CORE-082 : le texte affiché passe toujours par ici. Sans i18n, la fonction est l'identité,", "// CORE-082: displayed text always goes through here. Without i18n the function is the identity,") %>
<%= it.t("// ce qui rend l'activation ultérieure de l'i18n mécanique.", "// which makes enabling i18n later a mechanical change.") %>
<% if (it.options.i18n) { -%>
export { useTranslation } from 'react-i18next';
import { i18n } from '@shared/i18n/config';

export function t(key: string, fallback: string): string {
  return i18n.exists(key) ? i18n.t(key) : fallback;
}
<% } else { -%>
export function t(_key: string, fallback: string): string {
  return fallback;
}
<% } -%>
