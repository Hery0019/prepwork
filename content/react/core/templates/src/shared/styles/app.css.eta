/* <%= it.t("Feuille de style de l'application : Tailwind, les tokens du projet, puis la couche de base.", "Application stylesheet: Tailwind, the project tokens, then the base layer.") %> */
@import 'tailwindcss';
@import './tokens.css';
/* <%= it.t("Les surcharges d'équipe passent après le preset : un token redéclaré l'emporte.", 'Team overrides come after the preset: a redeclared token wins.') %> */
@import './tokens.override.css';

@layer base {
  html {
    color-scheme: <% if (it.design.dark) { %>light dark<% } else { %>light<% } %>;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: var(--leading-body);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    line-height: var(--leading-heading);
  }

  /* CORE-011 : un anneau de focus visible, construit sur les tokens. */
  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* CORE-036 : le mouvement est une préférence de l'utilisateur. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      transition-duration: 0.01ms;
    }
  }
}
