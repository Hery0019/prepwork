<%= it.t("// Mise en place des tests de modules serveur : seulement le serveur MSW, aucun DOM.", "// Setup for server module tests: only the MSW server, no DOM.") %>
import { afterAll, afterEach, beforeAll } from 'vitest';
import { server } from './src/shared/test/server';

beforeAll(() => {
  server.listen({ onUnhandledRequest: 'error' });
});

afterEach(() => {
  server.resetHandlers();
});

afterAll(() => {
  server.close();
});
