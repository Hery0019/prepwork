# <%= it.t("DOCK-001 : image multi-étapes construite depuis les sources, jamais depuis un bundle local.", "DOCK-001: multi-stage image built from the sources, never from a local bundle.") %>
FROM node:<%= it.stack.node %>-alpine AS build
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

# <%= it.t("DOCK-002 : nginx sert les fichiers statiques avec un utilisateur non root.", "DOCK-002: nginx serves the static files as a non-root user.") %>
FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# <%= it.t("DOCK-003 : la configuration d'exécution est injectée au démarrage, pas figée au build.", "DOCK-003: runtime configuration is injected at startup, not baked at build time.") %>
COPY docker-entrypoint.sh /docker-entrypoint.d/40-runtime-config.sh
EXPOSE 8080
