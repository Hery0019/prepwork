# <%= it.t("Environnement local : l'image de production, servie sur le port 8080.", "Local environment: the production image, served on port 8080.") %>
services:
  web:
    build: .
    image: <%= it.project.name %>:local
    ports:
      - '8080:8080'
    environment:
      # <%= it.t("DOCK-003 : la même image change d'API sans être reconstruite.", "DOCK-003: the same image switches API without being rebuilt.") %>
      VITE_API_BASE_URL: http://localhost:8081/api/v1
