#!/bin/sh
# <%= it.t('Hook pre-commit : aucun secret ne part dans un commit (CORE-070). Activé par `git config core.hooksPath .githooks`.', 'pre-commit hook: no secret ever enters a commit (CORE-070). Enabled with `git config core.hooksPath .githooks`.') %>

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<EOF
pre-commit: gitleaks <%= it.t('introuvable ; installation :', 'not found; install it:') %> https://github.com/gitleaks/gitleaks#installing
<%= it.t("Le commit est refusé tant que le hook ne peut pas vérifier l'absence de secrets (CORE-070).", 'The commit is refused until the hook can verify that no secret is staged (CORE-070).') %>
EOF
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
