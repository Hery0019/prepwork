<%= it.t("// NEXT-003 : la lecture se fait ici, sur le serveur, puis la donnée descend en props.", "// NEXT-003: the read happens here, on the server, then the data flows down as props.") %>
import { listNotes } from '@features/notes';
import { NoteList } from '@features/notes';

<%= it.t("// NEXT-013 : la page lit des données vivantes, donc elle est rendue à la demande.", '// NEXT-013: the page reads live data, so it is rendered on demand.') %>
export const dynamic = 'force-dynamic';

export default async function NotesPage() {
  const page = await listNotes(0);
  return <NoteList notes={page.content} />;
}
