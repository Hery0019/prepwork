<%= it.t("// CORE-010 : les trois états d'une liste sont écrits, jamais implicites.", "// CORE-010: the three states of a list are written down, never implicit.") %>
import { Link } from 'react-router';
import { NoteCard } from '@entities/note';
import { t } from '@shared/lib/text';
import { Alert, Button, Skeleton } from '@shared/ui';
import { useNotes } from '../model/useNotes';

export function NoteList() {
  const { data, isPending, error } = useNotes();

  if (isPending) {
    return (
      <div
        className="flex flex-col gap-4"
        role="status"
        aria-busy="true"
        aria-label={t('notes.loading', <%= it.t("'Chargement des notes'", "'Loading the notes'") %>)}
      >
        <Skeleton className="h-24" />
        <Skeleton className="h-24" />
      </div>
    );
  }

  if (error) {
    return (
      <Alert tone="error" title={t('notes.error.title', <%= it.t("'Les notes n\\'ont pas pu être chargées.'", "'The notes could not be loaded.'") %>)}>
        {t('notes.error.hint', <%= it.t("'Réessayer dans un instant, ou prévenir l\\'équipe si cela persiste.'", "'Try again in a moment, or tell the team if it persists.'") %>)}
      </Alert>
    );
  }

  if (data.content.length === 0) {
    return (
      <Alert title={t('notes.empty.title', <%= it.t("'Aucune note pour le moment.'", "'No notes yet.'") %>)}>
        <Link to="/notes/new">
          <Button size="sm">{t('notes.empty.action', <%= it.t("'Créer la première'", "'Create the first one'") %>)}</Button>
        </Link>
      </Alert>
    );
  }

  return (
    <ul className="flex flex-col gap-4">
      {data.content.map((note) => (
        <li key={note.id}>
          <NoteCard
            note={note}
            action={
              <Link to={`/notes/${note.id}`} className="text-primary underline">
                {t('notes.list.open', <%= it.t("'Ouvrir'", "'Open'") %>)}
              </Link>
            }
          />
        </li>
      ))}
    </ul>
  );
}
