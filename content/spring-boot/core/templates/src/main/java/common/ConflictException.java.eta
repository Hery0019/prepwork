package <%= it.project.basePackage %>.common;

/**
 * <%= it.t("Conflit avec l'état courant (doublon, version obsolète) : traduit en 409 par ApiExceptionHandler.", "Conflict with the current state (duplicate, stale version): translated to 409 by ApiExceptionHandler.") %>
