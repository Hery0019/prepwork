<% /* Configuration de base + contributions des options, fusion additive (it.merge). */ -%>
<%
const db = it.stack.database;
const dbName = it.project.dbName;
const defaultUrl = db === 'postgresql' ? 'jdbc:postgresql://localhost:5432/' + dbName
  : db === 'mysql' ? 'jdbc:mysql://localhost:3306/' + dbName
  : db === 'oracle' ? 'jdbc:oracle:thin:@localhost:1521/FREEPDB1'
  : '';
const main = { spring: { application: { name: it.project.name } } };
if (db !== 'none') {
  main.spring.datasource = {
    url: '${DB_URL:' + defaultUrl + '}',
    username: '${DB_USERNAME:' + dbName + '}',
    password: '${DB_PASSWORD:' + dbName + '}',
  };
  main.spring.jpa = { 'open-in-view': false, hibernate: { 'ddl-auto': 'validate' } };
}
main.management = { endpoints: { web: { exposure: { include: 'health,info' } } } };
main.app = { cors: { 'allowed-origins': '${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000}' } };
const dev = { spring: { config: { activate: { 'on-profile': 'dev' } } }, logging: { level: { [it.project.basePackage]: 'DEBUG' } } };
const prod = { spring: { config: { activate: { 'on-profile': 'prod' } } }, logging: { structured: { format: { console: 'ecs' } } } };
const extraProfiles = Object.entries(it.properties.profiles).filter(([name]) => name !== 'dev' && name !== 'prod');
-%>
# <%= it.d('Généré par prepwork. Les secrets viennent de variables d\'environnement (voir .env.example).', 'Generated by prepwork. Secrets come from environment variables (see .env.example).') %>
<%~ it.yaml(it.merge(main, it.properties.main)) %>

---
# <%= it.d('Développement local : logs lisibles et verbeux pour le package du projet.', 'Local development: readable, verbose logs for the project package.') %>
<%~ it.yaml(it.merge(dev, it.properties.profiles.dev ?? {})) %>

---
# <%= it.d('Production : logs JSON (ECS), jamais de donnée personnelle (CORE-016).', 'Production: JSON logs (ECS), never any personal data (CORE-016).') %>
<%~ it.yaml(it.merge(prod, it.properties.profiles.prod ?? {})) %>
<% for (const [name, tree] of extraProfiles) { -%>

---
<%~ it.yaml(it.merge({ spring: { config: { activate: { 'on-profile': name } } } }, tree)) %>
<% } -%>
