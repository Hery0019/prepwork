# <%= it.t("Pipeline CI (CIGH-001) : la même commande qu'en local, Docker disponible pour Testcontainers.", 'CI pipeline (CIGH-001): the same command as locally, Docker available for Testcontainers.') %>
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "<%= it.stack.java %>"
          cache: maven
      - name: Verify
        run: |
          chmod +x mvnw
          ./mvnw -B verify

  dependency-scan:
    # <%= it.t('Analyse des dépendances vulnérables (CIGH-002, CORE-035).', 'Vulnerable dependency scan (CIGH-002, CORE-035).') %>
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: fs
          scan-ref: .
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: "1"
