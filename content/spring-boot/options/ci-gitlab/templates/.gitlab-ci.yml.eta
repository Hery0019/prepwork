# <%= it.t("Pipeline CI (CIGL-001) : la même commande qu'en local, Docker-in-Docker pour Testcontainers.", 'CI pipeline (CIGL-001): the same command as locally, Docker-in-Docker for Testcontainers.') %>
stages:
  - verify
  - scan

variables:
  MAVEN_OPTS: "-Dmaven.repo.local=$CI_PROJECT_DIR/.m2/repository"
  DOCKER_HOST: tcp://docker:2375
  DOCKER_TLS_CERTDIR: ""
  TESTCONTAINERS_HOST_OVERRIDE: docker

cache:
  key: maven
  paths:
    - .m2/repository

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

verify:
  stage: verify
  image: eclipse-temurin:<%= it.stack.java %>-jdk
  services:
    - docker:27-dind
  script:
    - chmod +x mvnw
    - ./mvnw -B verify

dependency-scan:
  # <%= it.t('Analyse des dépendances vulnérables (CIGL-002, CORE-035).', 'Vulnerable dependency scan (CIGL-002, CORE-035).') %>
  stage: scan
  image:
    name: aquasec/trivy:latest
    entrypoint: [""]
  script:
    - trivy fs --scanners vuln --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 .
