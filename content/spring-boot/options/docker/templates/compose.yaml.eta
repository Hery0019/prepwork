<%
const db = it.stack.database;
const dbName = it.project.dbName;
-%>
# <%= it.t("Environnement local de référence (DOCK-003). `./mvnw spring-boot:run` démarre la base automatiquement ; `docker compose up` lance aussi l'application.", 'Reference local environment (DOCK-003). `./mvnw spring-boot:run` starts the database automatically; `docker compose up` also runs the application.') %>
services:
<% if (db === 'postgresql') { -%>
  db:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: <%= dbName %>
      POSTGRES_USER: <%= dbName %>
      POSTGRES_PASSWORD: <%= dbName %>
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U <%= dbName %> -d <%= dbName %>"]
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - db-data:/var/lib/postgresql/data
<% } else if (db === 'mysql') { -%>
  db:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: <%= dbName %>
      MYSQL_USER: <%= dbName %>
      MYSQL_PASSWORD: <%= dbName %>
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-proot"]
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - db-data:/var/lib/mysql
<% } else if (db === 'oracle') { -%>
  db:
    image: gvenzl/oracle-free:23-slim-faststart
    environment:
      ORACLE_PASSWORD: <%= dbName %>
      APP_USER: <%= dbName %>
      APP_USER_PASSWORD: <%= dbName %>
    ports:
      - "1521:1521"
    healthcheck:
      test: ["CMD", "healthcheck.sh"]
      interval: 10s
      timeout: 5s
      retries: 20
    volumes:
      - db-data:/opt/oracle/oradata
<% } -%>

  app:
    build: .
    image: <%= it.project.name %>:local
    labels:
      # <%= it.t("Ignoré par le support Docker Compose de Spring Boot : seul `db` est démarré par `spring-boot:run`.", 'Ignored by Spring Boot Docker Compose support: only `db` is started by `spring-boot:run`.') %>
      org.springframework.boot.ignore: true
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: prod
      APP_CORS_ALLOWED_ORIGINS: ${APP_CORS_ALLOWED_ORIGINS:-http://localhost:3000}
<% if (db === 'postgresql') { -%>
      DB_URL: jdbc:postgresql://db:5432/<%= dbName %>
<% } else if (db === 'mysql') { -%>
      DB_URL: jdbc:mysql://db:3306/<%= dbName %>
<% } else if (db === 'oracle') { -%>
      DB_URL: jdbc:oracle:thin:@db:1521/FREEPDB1
<% } -%>
<% if (db !== 'none') { -%>
      DB_USERNAME: <%= dbName %>
      DB_PASSWORD: <%= dbName %>
    depends_on:
      db:
        condition: service_healthy
<% } -%>
<% if (db !== 'none') { -%>

volumes:
  db-data:
<% } -%>
