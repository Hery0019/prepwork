package <%= it.project.basePackage %>.web;

import <%= it.project.basePackage %>.domain.Note;
import java.time.Instant;

/**
 * <%= it.t("DTO de sortie : liste exactement les champs exposés ; l'entité n'est jamais renvoyée (CORE-012).", "Output DTO: lists exactly the exposed fields; the entity is never returned (CORE-012).") %>
 */
public record NoteResponse(Long id, String title, String content, Instant createdAt) {

    public static NoteResponse from(Note note) {
        return new NoteResponse(note.getId(), note.getTitle(), note.getContent(), note.getCreatedAt());
    }
}
