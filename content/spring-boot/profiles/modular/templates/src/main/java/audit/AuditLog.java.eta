package <%= it.project.basePackage %>.audit;

import java.util.concurrent.atomic.AtomicLong;
import org.springframework.stereotype.Service;

/**
 * <%= it.t("Façade publique du module `audit` : compte les notes créées, alimentée par les événements du module `note` (MOD-005). Exemple volontairement minimal.", "Public facade of the `audit` module: counts created notes, fed by the `note` module events (MOD-005). Deliberately minimal example.") %>
 */
@Service
public class AuditLog {

    private final AtomicLong createdNotes = new AtomicLong();

    public void recordCreatedNote() {
        createdNotes.incrementAndGet();
    }

    public long createdNotes() {
        return createdNotes.get();
    }
}
