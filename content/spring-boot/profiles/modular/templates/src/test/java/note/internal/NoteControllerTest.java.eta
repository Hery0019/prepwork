package <%= it.project.basePackage %>.note.internal;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

import <%= it.project.basePackage %>.note.NoteDetails;
import <%= it.project.basePackage %>.note.NoteNotFoundException;
import <%= it.project.basePackage %>.note.NoteService;
import java.time.Instant;
import java.util.List;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
import org.springframework.data.domain.PageImpl;
import org.springframework.data.domain.PageRequest;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.assertj.MockMvcTester;

/**
 * <%= it.t("Niveau slice (CORE-020) : seul le contrôleur et l'advice sont chargés, la façade est un mock. Vérifie le contrat HTTP : validation, erreurs RFC 9457, forme des réponses.", "Slice level (CORE-020): only the controller and the advice are loaded, the facade is a mock. Verifies the HTTP contract: validation, RFC 9457 errors, response shape.") %>
 */
@WebMvcTest(NoteController.class)
class NoteControllerTest {

    private static final NoteDetails FIRST =
            new NoteDetails(1L, "First", "Hello", Instant.parse("2026-01-01T00:00:00Z"));

    @Autowired
    private MockMvcTester mvc;

    @MockitoBean
    private NoteService service;

    @Test
    void create_blankTitle_returns400ProblemDetail() {
        assertThat(mvc.post()
                        .uri("/api/v1/notes")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content("{\"title\": \"\"}"))
                .hasStatus(HttpStatus.BAD_REQUEST)
                .hasContentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON)
                .bodyJson()
                .extractingPath("$.errors[0].field")
                .isEqualTo("title");
    }

    @Test
    void get_unknownId_returns404ProblemDetail() {
        when(service.get(42L)).thenThrow(new NoteNotFoundException(42L));

        assertThat(mvc.get().uri("/api/v1/notes/42"))
                .hasStatus(HttpStatus.NOT_FOUND)
                .hasContentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON)
                .bodyJson()
                .extractingPath("$.detail")
                .asString()
                .contains("42");
    }

    @Test
    void list_defaultPage_returnsPaginatedShape() {
        when(service.list(any())).thenReturn(new PageImpl<>(List.of(FIRST), PageRequest.of(0, 20), 1));

        assertThat(mvc.get().uri("/api/v1/notes"))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.totalElements")
                .isEqualTo(1);
    }

    @Test
    void get_existingId_returnsNoteDetails() {
        when(service.get(1L)).thenReturn(FIRST);

        assertThat(mvc.get().uri("/api/v1/notes/1"))
                .hasStatusOk()
                .bodyJson()
                .extractingPath("$.title")
                .isEqualTo("First");
    }
}
