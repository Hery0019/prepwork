# Environment variables expected by the application (CORE-030). Copy to `.env`, never commit `.env`.

# Allowed CORS origins, comma-separated (never `*` in production, CORE-033)
CORS_ORIGINS=http://localhost:3000

# OIDC provider that issues the tokens; the application refuses to start without it.
JWT_AUTHORITY=https://auth.example.com/realms/app

# Expected audience of the tokens; empty disables the audience check (SECJ-004).
JWT_AUDIENCE=
