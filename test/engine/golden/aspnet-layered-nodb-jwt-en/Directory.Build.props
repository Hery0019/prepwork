<!-- Properties shared by every project. A package is never added here: it goes to the single project that uses it. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Invariant mode is incompatible with Microsoft.Data.SqlClient, which throws `Globalization Invariant Mode is not supported` when opening the connection. It would therefore stay `true` for PostgreSQL and become `false` for SQL Server: two otherwise identical projects would not compare strings the same way. Uniformly `false`, and the Docker image supplies ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CORE-035: a NuGet audit warning fails the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- The style declared in .editorconfig is checked at build time, not only by the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
