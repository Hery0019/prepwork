# Variables d'environnement attendues par l'application (CORE-030). Copier en `.env`, jamais commiter `.env`.

# Chaîne de connexion à la base
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=pay_flow;Username=pay_flow;Password=pay_flow

# Origines CORS autorisées, séparées par des virgules (jamais `*` en production, CORE-033)
CORS_ORIGINS=http://localhost:3000

# Chaîne de connexion à la base ; l'application refuse de démarrer sans elle.
DB_CONNECTION_STRING=
