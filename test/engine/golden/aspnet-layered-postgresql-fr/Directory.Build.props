<!-- Propriétés communes à tous les projets. Un paquet ne s'ajoute jamais ici : il s'ajoute au seul projet qui l'utilise. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Le mode invariant est incompatible avec Microsoft.Data.SqlClient, qui lève `Globalization Invariant Mode is not supported` à l'ouverture de la connexion. Il resterait donc à `true` pour PostgreSQL et à `false` pour SQL Server : deux projets par ailleurs identiques n'auraient pas la même comparaison de chaînes. Uniformément `false`, et l'image Docker fournit ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CORE-035 : un avertissement d'audit NuGet fait échouer le build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Le style déclaré dans .editorconfig est vérifié à la compilation, pas seulement par l'IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
