#!/bin/sh
# Hook commit-msg : Conventional Commits (GIT-001). Activé par `git config core.hooksPath .githooks`.

message_file="$1"
first_line=$(head -n 1 "$message_file")

# Les commits de fusion, de revert automatique et les fixup sont acceptés tels quels.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].{0,71}$'
if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: message refusé (GIT-001).
  Attendu : type(scope): subject
  Types   : feat fix docs style refactor perf test build ci chore revert
  Reçu    : $first_line
EOF
exit 1
