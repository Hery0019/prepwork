# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed (CORE-030).

# local | staging | production. Outside `local`, the interactive documentation is not served (CORE-036).
APP_ENV=local

# Allowed origins, comma-separated. Never `*` in production (CORE-033).
CORS_ORIGINS=["http://localhost:5173"]

# Signing key of the session cookie; generate one per environment and never commit it (SECS-002).
SESSION_SECRET=

# Cookie name; a name of its own avoids colliding with another application on the same domain.
SESSION_COOKIE_NAME=app_session
