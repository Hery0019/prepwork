; Generated by prepwork. Python has no compiler: this file is the only thing holding the layer boundaries. An `ignore_imports` entry added to unblock a build deletes the architecture quietly (PY-AP-002).
[importlinter]
root_package = edge_api
; Required: PY-003 to PY-005 forbid external packages (fastapi, sqlalchemy). Without this line, import-linter refuses to check those contracts.
include_external_packages = True

; PY-001 — the rule the whole architecture rests on. The layers come from the profile's `architecture.layers` block: the only place where their order is written a second time.
[importlinter:contract:PY_001]
name = PY_001 layers
type = layers
layers =
    api
    service
    repository
    domain
containers =
    edge_api

; PY-002 is not here: the composition root must name the repository to wire the session, so `api` → `repository` stays allowed by the layer contract. What has to be bounded — that the root is the only one doing it — is a test, not a contract.

[importlinter:contract:PY_003]
name = PY_003 domain is free of the web framework
type = forbidden
source_modules =
    edge_api.domain
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:PY_004]
name = PY_004 service has no fastapi symbol
type = forbidden
source_modules =
    edge_api.service
forbidden_modules =
    fastapi
    starlette

; PY-005 — `sqlalchemy` stays allowed in `domain`, which declares its mapping (PY-003); only statement building is confined to `repository`.
[importlinter:contract:PY_005]
name = PY_005 only repository builds statements
type = forbidden
; `api` is not listed: the composition root must name the session type to wire the request dependency. What bounds it is the PY-002 test, not this contract.
source_modules =
    edge_api.service
forbidden_modules =
    sqlalchemy
; Direct imports only: PY-003 lets `domain` carry its mapping, so every layer reaches `sqlalchemy` through the entity. Without this line the contract would be broken by construction, and the only way out would be ignoring imports — which PY-AP-002 forbids.
allow_indirect_imports = True
