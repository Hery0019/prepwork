# Copier en `.env` et remplir. `.env` est ignoré par git ; ce fichier-ci est commité (CORE-030).

# local | staging | production. Hors `local`, la documentation interactive n'est pas servie (CORE-036).
APP_ENV=local

# Origines autorisées, séparées par des virgules. Jamais `*` en production (CORE-033).
CORS_ORIGINS=["http://localhost:5173"]

# URL SQLAlchemy asynchrone ; le driver en fait partie et doit correspondre à la base choisie.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
