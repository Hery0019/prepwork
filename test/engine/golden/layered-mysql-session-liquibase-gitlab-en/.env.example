# Environment variables expected by the application (CORE-030). Copy to `.env`, never commit `.env`.

# Database
DB_URL=jdbc:mysql://localhost:3306/shop_api
DB_USERNAME=shop_api
DB_PASSWORD=shop_api

# Allowed CORS origins, comma-separated (never `*` in production, CORE-033)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Username of the bootstrap administrator (in-memory user store).
APP_ADMIN_USERNAME=admin

# Password of the bootstrap administrator; never the example value in production.
APP_ADMIN_PASSWORD=change-me
