# Variables d'environnement attendues par l'application (CORE-030). Copier en `.env`, jamais commiter `.env`.

# Origines CORS autorisées, séparées par des virgules (jamais `*` en production, CORE-033)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL de l'issuer du fournisseur d'identité ; son document de découverte fournit les clés de signature.
OAUTH2_ISSUER_URI=https://auth.example.com/realms/app
