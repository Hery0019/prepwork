# Variables d'environnement de l'application (CORE-046). Copier en `.env`, jamais commiter `.env`.
# Tout ce qui est préfixé NEXT_PUBLIC_ part dans le bundle et est donc public (CORE-070) ;
# le reste ne quitte jamais le serveur (NEXT-010).

API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=note-board

# Chemin de l'endpoint du backend-for-frontend qui démarre la connexion.
NEXT_PUBLIC_AUTH_LOGIN_PATH=/bff/login
