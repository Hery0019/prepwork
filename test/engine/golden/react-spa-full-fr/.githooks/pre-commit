#!/bin/sh
# Hook pre-commit : aucun secret ne part dans un commit (CORE-070). Activé par `git config core.hooksPath .githooks`.

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<EOF
pre-commit: gitleaks introuvable ; installation : https://github.com/gitleaks/gitleaks#installing
Le commit est refusé tant que le hook ne peut pas vérifier l'absence de secrets (CORE-070).
EOF
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
