#!/bin/sh
# commit-msg hook: Conventional Commits (GIT-001). Enabled with `git config core.hooksPath .githooks`.

message_file="$1"
first_line=$(head -n 1 "$message_file")

# Merge commits, automatic reverts and fixups are accepted as they are.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].{0,71}$'
if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: message rejected (GIT-001).
  Expected : type(scope): subject
  Types   : feat fix docs style refactor perf test build ci chore revert
  Received    : $first_line
EOF
exit 1
